# -----------------------------------------------------------------------------
# Copy to .env (or .env.local) for local development. On Netlify, set these
# under Site configuration → Environment variables.
# -----------------------------------------------------------------------------

# Public URL of the store (used in emails, sitemap and links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). For the local stack, run
# `npm run db:start` and copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase CLI only (npm run db:push / db:types) — never used by the app.
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Database password from project creation (optional with an access token).
SUPABASE_DB_PASSWORD=

# Server-only secret key. Needed to create staff accounts from the dashboard
# and by the seed scripts. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Brevo transactional email (https://app.brevo.com → SMTP & API → API keys).
# Leave blank locally: emails are printed to the server console instead.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=orders@example.com
EMAIL_FROM_NAME=JAG Marketplace

# Used only by `npm run seed:demo` / `npm run create-owner` (local development).
# Set both passwords for a cloud dev project: the built-in demo password is public.
SEED_OWNER_EMAIL=owner@jagmarket.test
SEED_OWNER_PASSWORD=
SEED_STAFF_PASSWORD=
